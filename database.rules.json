{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && newData.child('role').val() === 'siswa') || (auth.uid === $uid && data.exists() && (!newData.child('role').exists() || newData.child('role').val() === data.child('role').val())))"
      }
    },

    "siswa": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')",
      "$nisn": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('nisn').val() === $nisn",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
      }
    },

    "guru": {
      ".read": "auth != null",
      "$nip": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('nip').val() === $nip)"
      }
    },

    "rfid_map": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "riwayat": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')",
      "$tanggal": {
        "$nisn": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('nisn').val() === $nisn",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
        }
      }
    },

    "stats": {
      ".read": "auth != null",
      "$tanggal": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
      }
    },

    "perizinan": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')",
      "$id": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || (data.child('nisn').val() !== null && root.child('users').child(auth.uid).child('nisn').val() === data.child('nisn').val()))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && data.child('status').val() === 'pending'))"
      }
    },

    "chat_rooms": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')",
      "$roomId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || (root.child('users').child(auth.uid).child('nisn').val() !== null && ($roomId.beginsWith(root.child('users').child(auth.uid).child('nisn').val()) || $roomId.contains(root.child('users').child(auth.uid).child('nisn').val()))))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || (root.child('users').child(auth.uid).child('nisn').val() !== null && ($roomId.beginsWith(root.child('users').child(auth.uid).child('nisn').val()) || $roomId.contains(root.child('users').child(auth.uid).child('nisn').val()))))"
      }
    },

    "absensi": {
      ".read": "auth != null",
      "$nisn": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('nisn').val() === $nisn)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
      }
    },

    "kartu": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "pairing_request": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "presensi_jam": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
    },

    "presensi_guru": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
    },

    "kelas": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru' || root.child('users').child(auth.uid).child('role').val() === 'iot_gateway')"
    },

    "status_kelas": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')"
    },

    "perizinan_guru": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')"
    },

    "kendala_guru": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')"
    },

    "kendala_mengajar": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')"
    },

    "laporan_kendala": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')"
    },

    "jadwal_pelajaran": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'guru')"
    },

    "nfc_session": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "hwid_map": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "presensi_harian": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "tap_realtime": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
